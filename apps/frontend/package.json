{
  "name": "agent-failure-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "api:generate": "uv run python ../../scripts/export_openapi.py node_modules/.cache/agent-failure-openapi.json && openapi-typescript node_modules/.cache/agent-failure-openapi.json -o src/api/generated.ts && uv run python ../../scripts/generate_lab_identities.py && biome format --write src/api/generated.ts src/labIdentities.generated.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated.ts src/labIdentities.generated.ts",
    "dev": "vite",
    "dev:development": "vite --mode development",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "biome:check": "biome check --files-ignore-unknown=true .",
    "biome:write": "biome check --write --files-ignore-unknown=true ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.102.8",
    "aws-amplify": "^6.20.0",
    "lucide-react": "^1.39.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "react-use-websocket": "^4.13.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.3.0"
  }
}
