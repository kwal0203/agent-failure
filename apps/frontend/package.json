{
  "name": "agent-failure-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "api:generate": "uv run python ../../scripts/export_openapi.py node_modules/.cache/agent-failure-openapi.json && openapi-typescript node_modules/.cache/agent-failure-openapi.json -o src/api/generated.ts && uv run python ../../scripts/generate_lab_identities.py && biome format --write src/api/generated.ts src/labIdentities.generated.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated.ts src/labIdentities.generated.ts",
    "dev": "vite",
    "dev:development": "vite --mode development",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "biome:check": "biome check --files-ignore-unknown=true .",
    "biome:write": "biome check --write --files-ignore-unknown=true ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.101.4",
    "aws-amplify": "^6.20.0",
    "lucide-react": "^1.28.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-use-websocket": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.9.0",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.3.0"
  }
}
