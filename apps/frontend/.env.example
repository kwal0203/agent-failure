# Cluster endpoint
VITE_API_BASE_URL=

# Amplify Auth connection to an existing Cognito user pool/app client
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_ENROLLMENT_API_ENABLED=

# Optional toggles (defaults exist in code)
# VITE_UI_MODE=demo
# VITE_LAB_CATALOG_SOURCE=stub

# Server-only Vercel Function settings for /api/pilot-request.
# Do not prefix these with VITE_ or commit real secret values.
RESEND_API_KEY=
PILOT_LEAD_FROM=Agent Failure <leads@auth.agentfailure.com>
PILOT_LEAD_TO=
PILOT_ALLOWED_ORIGINS=https://agentfailure.com,https://www.agentfailure.com
