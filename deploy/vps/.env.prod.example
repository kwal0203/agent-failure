# External URL for migration commands run from your laptop:
# DATABASE_URL=postgresql+psycopg://user:pass@external-host:5432/db?sslmode=require
#
# For containers running on your VPS, prefer private/internal DB host if available:
DATABASE_URL=postgresql+psycopg://user:pass@db-host:5432/agent_failure_db

OPENROUTER_API_KEY=
PROVIDER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MODEL_NAME=deepseek/deepseek-v3.2
MODEL_TIMEOUT=30

RUNTIME_SHARED_TOKEN=
RUNTIME_TIMEOUT_SECONDS=60
MODEL_CLIENT_MODE=gateway

# Optional JWT verification config
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=
AUTH_JWKS_CACHE_TTL_SECONDS=300
