# Required
APP_ENV=production
DATABASE_URL=postgresql+psycopg://postgres:password@db-host:5432/agent_failure

# Runtime model/provider config
# Runtime Pods read RUNTIME_SHARED_TOKEN and OPENROUTER_API_KEY from the
# runtime-pool/runtime-secrets Kubernetes Secret.
MODEL_CLIENT_MODE=gateway
PROVIDER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MODEL_NAME=deepseek/deepseek-v3.2

# Orchestration policy
ORCHESTRATOR_PROVISIONING_WORKER_POLL_INTERVAL_SECONDS=0.1
ORCHESTRATOR_READINESS_TIMEOUT_SECONDS=30
ORCHESTRATOR_READINESS_POLL_INTERVAL_SECONDS=0.1
ORCHESTRATOR_PROVISIONING_RETRY_BACKOFF_SECONDS=15
ORCHESTRATOR_CLEANUP_MAX_ATTEMPTS=3
ORCHESTRATOR_CLEANUP_RETRY_BACKOFF_SECONDS=15
ORCHESTRATOR_CLEANUP_REVERIFY_BACKOFF_SECONDS=5
ORCHESTRATOR_PROVISIONING_TIMEOUT_SECONDS=900
ORCHESTRATOR_MAX_SESSION_LIFETIME_SECONDS=86400
