# Required
APP_ENV=production
DATABASE_URL=postgresql+psycopg://postgres:password@db-host:5432/agent_failure
OPENROUTER_API_KEY=
PROVIDER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MODEL_NAME=deepseek/deepseek-v3.2
RUNTIME_SHARED_TOKEN=
ENROLLMENT_TOKEN_SECRET=
AUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
AUTH_AUDIENCE=example-app-client-id
AUTH_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=https://www.agentfailure.com,https://agentfailure.com,https://app.agentfailure.com

# Numeric settings
RUNTIME_TIMEOUT_SECONDS=60
MODEL_TIMEOUT=30
AUTH_JWKS_CACHE_TTL_SECONDS=300
ENROLLMENT_TOKEN_TTL_SECONDS=600

# Optional runtime pod defaults consumed by provisioning path
MODEL_CLIENT_MODE=gateway
